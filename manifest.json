{
  "manifest_version": 3,
  "name": "KiCad Parts Clipper Ngx",
  "version": "2.0.0",
  "description": "Copy component data from Digikey, Mouser, or LCSC directly into KiCad symbol clipboard format.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "*://*.digikey.com/*",
    "*://*.digikey.com.br/*",
    "*://*.digikey.de/*",
    "*://*.mouser.com/*",
    "*://*.mouser.com.br/*",
    "*://*.mouser.de/*",
    "*://*.lcsc.com/*"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.digikey.com/*",
        "*://*.digikey.com.br/*",
        "*://*.digikey.de/*"
      ],
      "js": [
        "content-scripts/browser-polyfill.js",
        "settings.js",
        "content-scripts/digikey.js",
        "content-scripts/copy-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.mouser.com/*",
        "*://*.mouser.com.br/*",
        "*://*.mouser.de/*"
      ],
      "js": [
        "content-scripts/browser-polyfill.js",
        "settings.js",
        "content-scripts/mouser.js",
        "content-scripts/copy-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.lcsc.com/*"
      ],
      "js": [
        "content-scripts/browser-polyfill.js",
        "settings.js",
        "content-scripts/lcsc.js",
        "content-scripts/copy-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kicad_parts_clipper_ngx@marcelrobitaille.me",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
